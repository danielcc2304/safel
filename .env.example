# Local: vista previa sin contactar con Google. Producción sin configuración: off.
VITE_ADS_MODE=preview

# Rellenar con los identificadores reales de AdSense (no de AdMob).
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Cambiar a true solo después de publicar y verificar el mensaje de la CMP
# de Google en AdSense > Privacidad y mensajes, para el dominio de producción.
VITE_ADSENSE_CMP_READY=false

# Para activar después: VITE_ADS_MODE=live + cuenta/sitio aprobados + CMP lista.
# Las variables VITE_ son públicas. No guardar contraseñas ni claves privadas.
